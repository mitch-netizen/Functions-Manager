# Copy to .env.local and fill in. Never commit real values.

# From the Supabase project dashboard (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — never expose to the client, never used in a
# request-scoped path except the sanctioned exceptions in DECISIONS.md.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (see lib/email/resend-sender.ts).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Used to build links back into the app from transactional emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Checked against Vercel Cron's request header once app/api/cron/automation
# ships in Phase 5.
CRON_SECRET=
