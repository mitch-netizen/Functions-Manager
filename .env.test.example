# Used only by tests/rls/*.test.ts against a local `supabase start` instance.
# Copy to .env.test, run `supabase start`, then `supabase status -o env`
# to get the real values (URL / anon key / service_role key change per
# CLI version, so they are never hardcoded in the test helpers).

SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
